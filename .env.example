# API environment variables (Vercel: Project Settings -> Environment Variables;
# locally: copy to .env and run `npm run dev:api`).

# Supabase project URL and secret key (Project Settings -> API Keys -> "Secret keys").
# The secret key is used for Auth (verifying access tokens) and Storage only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection string from Supabase (Connect -> "Transaction pooler", port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Optional: DATABASE_POOL_SIZE=5, DATABASE_SSL=disable (only for a local Postgres)

# Origins allowed to call /api from another origin during local development.
ALLOWED_ORIGINS=http://localhost:8000

# Used only by the web build (scripts/vercel-build.sh), not by the API.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
API_BASE_URL=
