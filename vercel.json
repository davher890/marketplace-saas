{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "app/build/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/",
      "destination": "/api?__path=seo/home"
    },
    {
      "source": "/c/:slug",
      "destination": "/api?__path=seo/c/:slug"
    },
    {
      "source": "/product/:slug",
      "destination": "/api?__path=seo/product/:slug"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?__path=seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=seo/sitemap.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
